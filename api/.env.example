# Copy to api/.env for local development. Never commit the real file.

ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Models -------------------------------------------------------------------
# onnx = the real models in api/models (run: uv run python ../scripts/fetch_models.py)
# fake = deterministic stand-ins, handy for UI work without the weights
MODEL_BACKEND=onnx
# siglip2 (default) names all 200 dishes; efficientnet uses your Food-101 model (101 dishes)
# CLASSIFIER=siglip2
# DETECTOR_FILE=best.onnx        # optional: without it, each photo is one dish
# CONFIRM_BELOW=0.50

# --- Data ---------------------------------------------------------------------
# firestore = real Firestore (or the emulator when FIRESTORE_EMULATOR_HOST is set)
# memory    = in-process, lost on restart
DATA_BACKEND=firestore
FIREBASE_PROJECT_ID=food-tracker-8baa9
STORAGE_BUCKET=food-tracker-8baa9.firebasestorage.app
# Real project locally: gcloud auth application-default login   (or set GOOGLE_APPLICATION_CREDENTIALS)
# Emulators instead:    FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099  FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#                       FIREBASE_PROJECT_ID=demo-foodtracker

# --- External services ----------------------------------------------------------
LLM_BACKEND=gemini
GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models for the current stable model id.
GEMINI_MODEL=gemini-3.6-flash
CALORIENINJAS_API_KEY=
