# Copy to web/.env.local for local development.

# Where the API runs.
VITE_API_URL=http://localhost:8000

# Firebase web config (public by design; protect data with security rules).
# On Firebase Hosting these are read from /__/firebase/init.json automatically, so you can leave
# them empty in production builds.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=food-tracker-8baa9.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=food-tracker-8baa9
VITE_FIREBASE_STORAGE_BUCKET=food-tracker-8baa9.firebasestorage.app
VITE_FIREBASE_APP_ID=

# Local emulators (set both to use them; use FIREBASE project "demo-foodtracker").
# VITE_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
# VITE_FIREBASE_STORAGE_EMULATOR=127.0.0.1:9199
